{
  "name": "sja-website-concept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/cloudflare.mjs dev --ip 0.0.0.0 --port 8787",
    "check": "node --check public/app.js && node --check src/worker.js && node scripts/cloudflare.mjs deploy --dry-run --outdir .output",
    "check:headers": "node --use-env-proxy --use-system-ca scripts/verify-headers.mjs",
    "test": "node --test tests/worker.test.js tests/security.test.js tests/verify-headers.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "demo": "node scripts/export-demo.mjs",
    "deploy": "node scripts/cloudflare.mjs deploy"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "wrangler": "4.151.3"
  }
}
